{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pvp:bot",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "pvp:swing_id": {
          "type": "int",
          "range": [0, 15],
          "default": 0,
          "client_sync": true
        },
        "pvp:using": {
          "type": "int",
          "range": [0, 2],
          "default": 0,
          "client_sync": true
        },
        "pvp:blocking": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "pvp:despawn": {
        "minecraft:instant_despawn": {}
      },

      "pvp:bow_mode": {
        "minecraft:shooter": { "def": "minecraft:arrow" },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "burst_shots": 1,
          "charge_charged_trigger": 0.0,
          "charge_shoot_trigger": 0.0,
          "attack_interval_min": 1.0,
          "attack_interval_max": 2.0,
          "attack_radius": 24.0,
          "attack_radius_min": 4.0,
          "ranged_fov": 90.0,
          "speed_multiplier": 0.6,
          "target_in_sight_time": 0.2
        }
      }
    },

    "events": {
      "pvp:despawn": {
        "add": { "component_groups": ["pvp:despawn"] }
      },
      "pvp:bow_mode": {
        "add": { "component_groups": ["pvp:bow_mode"] }
      },
      "pvp:melee_mode": {
        "remove": { "component_groups": ["pvp:bow_mode"] }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["pvp_bot", "humanoid", "mob"]
      },

      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:physics": { "has_collision": true, "has_gravity": true },
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:can_climb": {},
      "minecraft:jump.static": { "jump_power": 0.42 },
      "minecraft:movement.basic": {},
      "minecraft:movement": { "value": 0.1 },
      "minecraft:underwater_movement": { "value": 0.02 },
      "minecraft:navigation.walk": {
        "is_amphibious": false,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_break_doors": false,
        "can_jump": true,
        "can_sink": true,
        "avoid_damage_blocks": true,
        "avoid_portals": true
      },

      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:knockback_resistance": { "value": 0 },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "entity_attack",
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "bool_property",
                "subject": "self",
                "domain": "pvp:blocking",
                "operator": "equals",
                "value": true
              }
            }
          },
          {
            "cause": "projectile",
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "bool_property",
                "subject": "self",
                "domain": "pvp:blocking",
                "operator": "equals",
                "value": true
              }
            }
          }
        ]
      },

      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },

      "minecraft:equipment": { "table": "loot_tables/empty.json" },
      "minecraft:inventory": {
        "inventory_size": 36,
        "container_type": "container",
        "can_be_siphoned_from": false,
        "private": true
      },
      "minecraft:attack": { "damage": 0 },

      "minecraft:loot": { "table": "loot_tables/empty.json" },
      "minecraft:experience_reward": { "on_death": "0" },
      "minecraft:persistent": {},
      "minecraft:nameable": { "always_show": false, "allow_name_tag_renaming": true },
      "minecraft:conditional_bandwidth_optimization": {},

      "minecraft:behavior.float": { "priority": 0 },

      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": true,
        "must_see_forget_duration": 3.0,
        "reselect_targets": true,
        "within_radius": 32.0,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 32
          },
          {
            "filters": { "test": "is_family", "subject": "other", "value": "pvp_bot" },
            "max_dist": 32
          }
        ]
      },

      "minecraft:behavior.look_at_target": {
        "priority": 8,
        "look_distance": 32.0,
        "angle_of_view_horizontal": 360,
        "angle_of_view_vertical": 360,
        "probability": 1.0,
        "look_time": [4.0, 8.0]
      },

      "minecraft:behavior.random_look_around": {
        "priority": 9,
        "look_distance": 8.0,
        "look_time": [1.0, 4.0]
      }
    }
  }
}
