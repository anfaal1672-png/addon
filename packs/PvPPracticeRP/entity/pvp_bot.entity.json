{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "pvp:bot",

      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/steve"
      },
      "geometry": {
        "default": "geometry.humanoid.custom"
      },

      "spawn_egg": {
        "base_color": "#00AFAF",
        "overlay_color": "#B58C7F"
      },

      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "v.last_swing_id = -1.0;",
          "v.swing_start = -100.0;",
          "v.attack_time = -1.0;",
          "v.attack_body_rot_y = 0.0;",
          "v.use_item_startup_progress = 0.0;",
          "v.use_item_interval_progress = 0.0;",
          "v.is_holding_right = 0.0;",
          "v.is_holding_left = 0.0;",
          "v.tcos0 = 0.0;",
          "v.item_use_duration = 0.0;",
          "v.use_item_total_ticks = 32.0;"
        ],
        "pre_animation": [
          "v.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.riding_y_offset = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat', 'minecraft:strider') ? -3.0 : 0.0;",
          "v.helmet_layer_visible = 1.0;",
          "v.leg_layer_visible = 1.0;",
          "v.boot_layer_visible = 1.0;",
          "v.chest_layer_visible = 1.0;",
          "v.swing_id = q.property('pvp:swing_id');",
          "(v.swing_id != v.last_swing_id) ? { v.last_swing_id = v.swing_id; v.swing_start = q.life_time; };",
          "v.swing_elapsed = q.life_time - v.swing_start;",
          "v.attack_time = (v.swing_elapsed >= 0.0 && v.swing_elapsed < 0.3) ? math.clamp(v.swing_elapsed / 0.3, 0.0, 1.0) : -1.0;",
          "v.attack_body_rot_y = math.sin(360.0 * math.sqrt(math.max(v.attack_time, 0.0))) * 5.0;",
          "v.is_holding_right = query.get_equipped_item_name != '' ? 1.0 : 0.0;",
          "v.is_holding_left = 0.0;",
          "v.item_use_duration = q.property('pvp:using') > 0 ? (v.item_use_duration + query.delta_time * 20.0) : 0.0;",
          "v.use_item_startup_progress = q.property('pvp:using') == 1 ? 1.0 : 0.0;",
          "v.use_item_interval_progress = q.property('pvp:using') == 1 ? math.mod(v.item_use_duration, 4.0) / 4.0 : 0.0;",
          "v.use_item_total_ticks = q.property('pvp:using') == 2 ? 20.0 : 32.0;",
          "v.item_use_normalized = math.clamp(v.item_use_duration / v.use_item_total_ticks, 0.0, 1.0);"
        ],
        "variables": {
          "variable.item_use_normalized": "public",
          "variable.attack_time": "public",
          "variable.attack_body_rot_y": "public",
          "variable.use_item_startup_progress": "public",
          "variable.use_item_interval_progress": "public",
          "variable.is_holding_right": "public",
          "variable.is_holding_left": "public",
          "variable.use_item_total_ticks": "public"
        },
        "animate": [
          "look_at_target_controller",
          { "move.arms": "!query.is_swimming" },
          { "move.legs": "!query.is_swimming" },
          "riding_controller",
          "holding_controller",
          "brandish_spear_controller",
          "charging_controller",
          "attack_controller",
          "sneaking_controller",
          "bob_controller",
          "damage_nearby_mobs_controller",
          "use_item_progress_controller",
          { "bow_equipped": "q.property('pvp:using') == 2" },
          { "shield_block_off_hand": "q.property('pvp:blocking')" },
          { "swimming": "query.is_swimming" },
          { "swimming.legs": "query.is_swimming" }
        ],
        "should_update_effects_offscreen": "1.0"
      },

      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",

        "move.arms": "animation.player.move.arms",
        "move.legs": "animation.player.move.legs",
        "attack.rotations": "animation.player.attack.rotations",
        "holding": "animation.player.holding",
        "sneaking": "animation.player.sneaking",
        "bob": "animation.player.bob",
        "bow_equipped": "animation.player.bow_equipped",
        "shield_block_off_hand": "animation.player.shield_block_off_hand",
        "swimming": "animation.player.swim",
        "swimming.legs": "animation.player.swim.legs",

        "riding.arms": "animation.player.riding.arms",
        "riding.legs": "animation.player.riding.legs",
        "riding.body": "animation.humanoid.riding.body",
        "brandish_spear": "animation.humanoid.brandish_spear",
        "charging": "animation.humanoid.charging",
        "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
        "use_item_progress": "animation.humanoid.use_item_progress",

        "look_at_target_controller": "controller.animation.humanoid.look_at_target",
        "riding_controller": "controller.animation.humanoid.riding",
        "holding_controller": "controller.animation.humanoid.holding",
        "brandish_spear_controller": "controller.animation.humanoid.brandish_spear",
        "charging_controller": "controller.animation.humanoid.charging",
        "attack_controller": "controller.animation.humanoid.attack",
        "sneaking_controller": "controller.animation.humanoid.sneaking",
        "bob_controller": "controller.animation.humanoid.bob",
        "damage_nearby_mobs_controller": "controller.animation.humanoid.damage_nearby_mobs",
        "use_item_progress_controller": "controller.animation.humanoid.use_item_progress"
      },

      "render_controllers": ["controller.render.pvp_bot"],

      "enable_attachables": true
    }
  }
}
